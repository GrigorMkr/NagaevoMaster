# Сборка для nagaevomaster.ru (npm run build:hosting)
VITE_BASE=/
# VPS REG.RU (рекомендуется):
VITE_API_URL=https://api.nagaevomaster.ru/api
VITE_USE_MOCK_FALLBACK=false
# Запасной вариант — Render:
# VITE_API_URL=https://nagaevomaster-api.onrender.com/api
# OAuth — ключи на сервере API (см. deploy/oauth.env.example)
# Локально скопируйте в backend/.env после создания приложений Google / VK
