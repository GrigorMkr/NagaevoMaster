# GitFlic API — не коммитить. Скопируйте в deploy/gitflic.env
# Профиль → Настройки → API токены (repository_read/write не обязательны для API)

GITFLIC_TOKEN=
GITFLIC_OWNER=impherion
GITFLIC_PROJECT=nagaevo-master
# Псевдоним компании (для runner). Оставьте пустым — скрипт попробует определить сам.
GITFLIC_COMPANY=
