# Скопируйте: cp deploy/oauth.env.example deploy/oauth.env
# Заполните ключи, затем: npm run vps:oauth
#
# === Google Cloud Console ===
# 1. https://console.cloud.google.com/apis/credentials
# 2. OAuth client ID → Web application
# 3. Authorized redirect URIs (оба, если используете API-субдомен):
#    https://nagaevomaster.ru/api/auth/google/callback
#    https://api.nagaevomaster.ru/api/auth/google/callback
#
# === VK (https://vk.com/apps?act=manage) ===
# 1. Создайте приложение «Веб-сайт»
# 2. Адрес сайта: https://nagaevomaster.ru
# 3. Redirect URI:
#    https://nagaevomaster.ru/api/auth/vk/callback
#    https://api.nagaevomaster.ru/api/auth/vk/callback
#
# SITE_URL — адрес сайта для возврата после входа (страница /auth)

SITE_URL=https://nagaevomaster.ru
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_SERVICE_TOKEN=
