# Скопируйте на VPS: /var/www/nagaevomaster/backend/.env

NODE_ENV=production
PORT=4000

JWT_SECRET=замените-на-длинный-случайный-ключ

CORS_ORIGIN=https://nagaevomaster.ru,https://www.nagaevomaster.ru

UPLOAD_DIR=/var/www/nagaevomaster/backend/uploads
PUBLIC_UPLOAD_URL=/uploads

# Пароль должен совпадать с POSTGRES_PASSWORD в install.sh / DATABASE_URL
POSTGRES_PASSWORD=замените-на-надёжный-пароль
DATABASE_URL=postgresql://nagaevomaster:ЗАМЕНИТЕ_ПАРОЛЬ@127.0.0.1:5432/nagaevomaster?schema=public

# Email-коды регистрации (см. deploy/NOTIFY.md)
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@nagaevomaster.ru
SMTP_PASS=
SMTP_FROM=Нагаево Мастер <noreply@nagaevomaster.ru>

# SMS-коды через SMS.ru (https://sms.ru)
SMS_RU_API_ID=

# VK ID — npm run oauth:setup && npm run vps:oauth
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# VK Карты — RuStore → Инструменты → VK Карты (см. mobile/RUSTORE-TOOLS.md)
# VK_MAPS_API_KEY=
