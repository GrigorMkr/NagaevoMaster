# Web Push (VAPID) + FCM для Android-приложения
# Скопируйте в deploy/push.env и запустите npm run vps:push
# VAPID: npm run vapid:generate
# FCM для Android APK (HTTP v1, рекомендуется):
#   npm run fcm:setup
# FCM legacy (устарело): Server key из Firebase Console → Cloud Messaging
FCM_PROJECT_ID=nagaevomaster

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@nagaevomaster.ru
FCM_SERVER_KEY=
