# REG.RU — секреты (не коммитить). Скопируйте: cp deploy/regru.env.example deploy/regru.env

# Cloud VPS API (ЛК → Облако → Настройки → Токен для API и Terraform)
REGRU_CLOUD_TOKEN=

# REG.API 2 для DNS (reg.ru → Настройки API → альтернативный пароль + разрешённый IP)
REGRU_API_USERNAME=
REGRU_API_PASSWORD=

# DNS A-запись для API
REGRU_DNS_ZONE=nagaevomaster.ru
REGRU_DNS_SUBDOMAIN=api
REGRU_VPS_IP=161.104.18.17
