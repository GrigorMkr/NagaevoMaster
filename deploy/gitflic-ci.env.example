# Переменные CI/CD для GitFlic → RuStore
# GitFlic: Проект → Настройки → CI/CD → Переменные
#
# Репозиторий: https://gitflic.ru/project/impherion/nagaevo-master

# === RuStore API (обязательно для deploy) ===
# console.rustore.ru → Разработчик → API RuStore → Создать ключ
RS_KEY_ID=
RS_PRIVATE_KEY=

# Альтернативные имена (шаблон RuStore на gitverse):
# KEY_ID=
# PRIVATE_KEY=

# === Подпись APK (обязательно для build) ===
# Локально: base64 android/nagaevomaster-release.keystore
#   Linux:   base64 -w0 android/nagaevomaster-release.keystore
#   Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("android/nagaevomaster-release.keystore"))
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=nagaevomaster
ANDROID_KEY_PASSWORD=

# === Firebase push (рекомендуется) ===
# Содержимое deploy/google-services.json одной строкой или base64
GOOGLE_SERVICES_JSON=

# === VK Карты в bundled APK (опционально) ===
VK_MAPS_API_KEY=
