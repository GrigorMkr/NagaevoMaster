# Скопируйте: cp deploy/vkwidgets.env.example deploy/vkwidgets.env
# ID приложения VK — тот же, что VK_CLIENT_ID (тип «Веб-сайт» в vk.com/apps).
# Ключ нужен для виджетов Open API: ContactUs, Post, Comments, Like и др.

# === Обязательно для Open API-виджетов ===
VK_WIDGETS_API_ID=

# ID сообщества (отрицательное число, как owner_id). Пример: -166562603
VK_COMMUNITY_ID=

# Текст кнопки «Напишите нам»
VK_CONTACT_US_TEXT=Напишите нам

# === Видео (страница /app, RuStore) ===
# Можно указать прямую ссылку:
# VK_VIDEO_URL=https://vk.ru/video-22822305_456241864
# или oid + id из кода экспорта:
# VK_VIDEO_OID=-22822305
# VK_VIDEO_ID=456241864
VK_VIDEO_URL=
# VK_VIDEO_HASH=
# VK_VIDEO_HD=2

# === Запись на стене (страница «О проекте») ===
# Экспорт записи → код виджета → owner_id, post_id, hash
# VK_WALL_POST_OWNER_ID=-76477496
# VK_WALL_POST_ID=192110
# VK_WALL_POST_HASH=
