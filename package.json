    "vps:oauth": "node scripts/vps/apply-oauth-env.mjs",
    "vps:push": "node scripts/vps/apply-push-env.mjs",
    "vps:vkmaps": "node scripts/vps/apply-vkmaps-env.mjs",
    "vps:vkwidgets": "node scripts/vps/apply-vkwidgets-env.mjs",
