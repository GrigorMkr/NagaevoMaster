    "lucide-react": "^1.21.0",
    "mmr-gl": "^0.2.43",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.78.0",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.17.0",
    "zod": "^4.4.3"
