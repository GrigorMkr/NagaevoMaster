{
  "name": "nagaevomaster",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run images:listings:verify && tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -b",
    "preview": "vite preview",
    "images:listings": "node scripts/import-user-listing-images.mjs || node scripts/download-listing-images.mjs || node scripts/generate-listing-placeholders.mjs",
    "images:listings:import": "node scripts/import-user-listing-images.mjs",
    "images:listings:local": "node scripts/generate-listing-placeholders.mjs",
    "images:listings:prune": "node scripts/prune-listing-duplicates.mjs",
    "images:listings:verify": "node scripts/verify-listing-images.mjs",
    "images:listings:landscapes": "node scripts/copy-listing-images.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.17.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.78.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
