{
  "name": "nagaevomaster",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run images:listings:verify && tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build:pages": "cross-env VITE_BASE=/NagaevoMaster/ VITE_USE_MOCK_FALLBACK=true npm run build",
    "build:hosting": "node scripts/build-hosting.mjs",
    "package:hosting": "node scripts/package-hosting.mjs",
    "deploy:hosting": "node scripts/deploy-hosting.mjs",
    "deploy:render": "node scripts/open-render-deploy.mjs",
    "deploy:full": "node scripts/wait-api-and-deploy.mjs",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc -b",
    "preview": "vite preview",
    "images:listings": "node scripts/import-user-listing-images.mjs || node scripts/download-listing-images.mjs || node scripts/generate-listing-placeholders.mjs",
    "images:listings:import": "node scripts/import-user-listing-images.mjs",
    "images:listings:local": "node scripts/generate-listing-placeholders.mjs",
    "images:listings:prune": "node scripts/prune-listing-duplicates.mjs",
    "images:listings:verify": "node scripts/verify-listing-images.mjs",
    "images:listings:landscapes": "node scripts/copy-listing-images.mjs",
    "vps:ssh-setup": "node scripts/vps/setup-ssh-key.mjs",
    "vps:install": "node scripts/vps/remote-install.mjs",
    "vps:deploy": "node scripts/vps/remote-deploy-api.mjs",
    "vps:notify": "node scripts/vps/apply-notify-env.mjs",
    "vps:notify:test": "node scripts/vps/test-notify.mjs",
    "vps:oauth": "node scripts/vps/apply-oauth-env.mjs",
    "vps:push": "node scripts/vps/apply-push-env.mjs",
    "vps:captcha": "node scripts/vps/apply-captcha-env.mjs",
    "oauth:setup": "node scripts/setup-oauth.mjs",
    "vapid:generate": "node scripts/generate-vapid.mjs",
    "cap:sync": "npx cap sync",
    "android:env": "node scripts/setup-android-local.mjs",
    "cap:sync:android": "node scripts/setup-android-local.mjs && npx cap sync android",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "build:apk": "node scripts/build-apk.mjs",
    "version:sync": "node scripts/sync-app-version.mjs",
    "site:sync": "node scripts/sync-site-version.mjs",
    "build:mobile": "node scripts/build-mobile.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@vkid/sdk": "^2.6.5",
    "axios": "^1.17.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.78.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "basic-ftp": "^5.0.5",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "ssh2": "^1.17.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
