    "cap:ios": "npx cap open ios",
    "build:apk": "node scripts/build-apk.mjs",
    "build:apk:bundled": "cross-env CAPACITOR_BUNDLED=1 node scripts/build-apk.mjs",
    "build:rustore": "node scripts/build-rustore.mjs",
    "rustore:cert": "node scripts/rustore/export-signing-cert.mjs",
    "rustore:auth": "node scripts/rustore/auth-token.mjs",
    "rustore:deploy": "node scripts/rustore/deploy.mjs",
    "rustore:assets": "node scripts/prepare-rustore-assets.mjs",
