# Локально: прокси Vite на backend (http://localhost:4000)
VITE_API_URL=/api

# GitHub Pages без backend: включить демо-данные при ошибке API
# VITE_USE_MOCK_FALLBACK=true

# Закрытый режим для посетителей (на GitHub Pages включено в CI)
# VITE_SITE_CLOSED=true

# Подтверждение в Search Console / Вебмастере (см. deploy/SEO.md)
# VITE_GOOGLE_SITE_VERIFICATION=
# VITE_YANDEX_SITE_VERIFICATION=
# VITE_PREVIEW_ACCESS_KEY=nagaevo-preview

VITE_MAP_TOKEN=
VITE_RECAPTCHA_SITE_KEY=
