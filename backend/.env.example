DATABASE_URL="postgresql://nagaevo:nagaevo@localhost:5432/nagaevomaster?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
UPLOAD_DIR="./uploads"
PUBLIC_UPLOAD_URL="/uploads"

# Email-коды (без SMTP в dev код пишется в лог сервера)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Нагаево Мастер <noreply@nagaevomaster.ru>"

# SMS-коды через SMS.ru (без ключа в dev код пишется в лог сервера)
SMS_RU_API_ID=

# OAuth (Google Cloud + VK приложение)
SITE_URL=https://nagaevomaster.ru
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Web Push (npm run vapid:generate)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@nagaevomaster.ru

# VK Maps (RuStore → Инструменты → VK Карты)
VK_MAPS_API_KEY=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
